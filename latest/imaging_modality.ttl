@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fbbi: <http://purl.obolibrary.org/obo/FBbi_> .
@prefix liblab: <https://w3id.org/liblab/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

liblab:LIBLAB_0000002 a skos:Concept ;
    skos:altLabel "LSFM"@en,
        "SPIM"@en,
        "light sheet fluorescence microscopy"@en,
        "selective plane illumination microscopy"@en ;
    skos:broader liblab:LIBLAB_0000001 ;
    skos:definition "Fluorescence microscopy in which the sample is illuminated from the side by a thin sheet of light, so that only the focal plane is excited, and imaged through a detection objective perpendicular to the sheet."@en ;
    skos:exactMatch fbbi:00000369 ;
    skos:inScheme <https://w3id.org/liblab/vocabulary/imaging_modality> ;
    skos:notation "LIBLAB:0000002" ;
    skos:prefLabel "light-sheet microscopy"@en .

liblab:LIBLAB_0000003 a skos:Concept ;
    skos:altLabel "high content imaging"@en,
        "high-content microscopy"@en ;
    skos:broader liblab:LIBLAB_0000001 ;
    skos:definition "Automated microscopy of many samples, typically in multi-well plates, combined with quantitative image analysis that extracts many measurements per cell or sample."@en ;
    skos:inScheme <https://w3id.org/liblab/vocabulary/imaging_modality> ;
    skos:notation "LIBLAB:0000003" ;
    skos:prefLabel "high content microscopy"@en .

liblab:LIBLAB_0000001 a skos:Concept ;
    skos:definition "Imaging of a specimen at magnification using a microscope."@en ;
    skos:exactMatch fbbi:00000241 ;
    skos:inScheme <https://w3id.org/liblab/vocabulary/imaging_modality> ;
    skos:narrower liblab:LIBLAB_0000002,
        liblab:LIBLAB_0000003 ;
    skos:notation "LIBLAB:0000001" ;
    skos:prefLabel "microscopy"@en ;
    skos:topConceptOf <https://w3id.org/liblab/vocabulary/imaging_modality> .

<https://w3id.org/liblab/vocabulary/imaging_modality> a skos:ConceptScheme ;
    dcterms:title "imaging_modality" ;
    owl:versionInfo "0.0.1" ;
    skos:hasTopConcept liblab:LIBLAB_0000001 .

